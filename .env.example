# ========== Application ==========
APP_NAME=MediaResolverAPI
DEBUG=false
HOST=0.0.0.0
PORT=8000
API_KEY=your-api-key

# ========== Database ==========
DATABASE_URL=sqlite:///./data/media_resolver.db

# ========== TikHub API ==========
TIKHUB_API_BASE=https://api.tikhub.io
TIKHUB_API_KEY=your-tikhub-api-key

# ========== Cobalt API ==========
COBALT_API_BASE=http://your-cobalt-server:9005/
COBALT_ENABLED=true
COBALT_TIMEOUT_SECONDS=60

# ========== OpenAI (Translation) ==========
OPENAI_API_KEY=your-openai-api-key
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
TRANSLATION_ENABLED=true

# ========== Cache ==========
CACHE_ENABLED=true
CACHE_TTL_HOURS=12

# ========== HTTP Client ==========
HTTP_TIMEOUT_SECONDS=30

# ========== Logging ==========
LOG_LEVEL=INFO
LOG_FILE_PATH=./logs
LOG_RETENTION_DAYS=30
