# ========== Application ==========
APP_NAME=MediaResolverAPI
DEBUG=false
HOST=0.0.0.0
PORT=8000
API_KEY=your-api-key
# 对外公开基址。留空即自动按请求 Host 推导；仅在反向代理后面且代理未透传正确 Host 时才需要设置。
# 例：PUBLIC_BASE_URL=https://media.example.org
PUBLIC_BASE_URL=

# ========== Database ==========
DATABASE_URL=sqlite:///./data/media_resolver.db

# ========== TikHub API ==========
TIKHUB_API_BASE=https://api.tikhub.io
TIKHUB_API_KEY=your-tikhub-api-key
# 客户端限流：每秒最多并发请求 TikHub 的次数
TIKHUB_RATE_LIMIT=10

# TikTok 多区域降级（逗号分隔，按优先级排序）。
# 主端点失败后，依次用这些区域重试 fetch_one_video_v3。
TIKTOK_FALLBACK_REGIONS=SA,US,JP

# ========== Cobalt API ==========
# Cobalt 自建服务地址，留空则禁用 Cobalt 兜底。示例：http://your-cobalt-server:9005/
COBALT_API_BASE=
COBALT_ENABLED=true
COBALT_TIMEOUT_SECONDS=60

# ========== OpenAI (Translation) ==========
OPENAI_API_KEY=your-openai-api-key
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
TRANSLATION_ENABLED=true

# ========== Cache ==========
CACHE_ENABLED=true
CACHE_TTL_HOURS=12

# ========== Usage Log ==========
USAGE_LOG_RETENTION_DAYS=30

# ========== HTTP Client ==========
HTTP_TIMEOUT_SECONDS=30

# ========== WeChat Channels streaming proxy ==========
# 同时进行的流式下载上限，超限返回 429
MAX_CONCURRENT_STREAMS=4
# 转发块大小（字节）
STREAM_CHUNK_SIZE=65536
# CDN 有界窗口大小（字节）。每个窗口整块读完才向客户端转发
STREAM_WINDOW_BYTES=4194304

# ========== Logging ==========
LOG_LEVEL=INFO
LOG_FILE_PATH=./logs
LOG_RETENTION_DAYS=30

# ========== Provider 优先级覆盖（可选） ==========
# 覆盖每个平台的数据源尝试顺序，逗号分隔，按优先级排序。
# 取值：tikhub, cobalt。留空则使用代码内置默认顺序。
# 例：PROVIDER_PRIORITY_TIKTOK=cobalt,tikhub  # 让 TikTok 先走 Cobalt
PROVIDER_PRIORITY_DOUYIN=
PROVIDER_PRIORITY_TIKTOK=
PROVIDER_PRIORITY_KUAISHOU=
PROVIDER_PRIORITY_XIAOHONGSHU=
PROVIDER_PRIORITY_YOUTUBE=
PROVIDER_PRIORITY_INSTAGRAM=
PROVIDER_PRIORITY_PINTEREST=
PROVIDER_PRIORITY_FACEBOOK=
PROVIDER_PRIORITY_WECHAT_CHANNELS=
